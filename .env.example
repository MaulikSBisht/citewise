# Copy to .env and fill in. .env is gitignored — never commit it.
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Only needed for identity-linked API keys, which must name the workspace each
# request acts in. Without it those keys return:
#   400 anthropic-workspace-id is required when authenticating with an
#   identity-linked API key
# Leave blank for a plain API key. Find it in the Anthropic Console URL when
# viewing a workspace (wrkspc_...).
ANTHROPIC_WORKSPACE_ID=
